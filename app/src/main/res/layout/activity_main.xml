<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"  xmlns:app="http://schemas.android.com/apk/res-auto"  xmlns:tools="http://schemas.android.com/tools"  android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical"
    tools:context=".MainActivity">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Welcome to Login Page"
        android:layout_gravity="center"
        android:gravity="center"
        android:layout_marginTop="170dp"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/white"/>
    <EditText
        android:id="@+id/eTName"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/black"
        android:hint="Please Enter Your Name"  android:layout_margin="20dp"
        android:gravity="center"
        />
    <EditText
        android:id="@+id/eTPassword"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/black"
        android:hint="Please Enter Your Password"  android:layout_margin="20dp"
        android:gravity="center"
        />
    <Button
        android:id="@+id/btnSave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SAVE DATA"
        android:layout_margin="20dp"
        android:layout_gravity="center"
        android:gravity="center"/>
</LinearLayout>